[
  {
    "id": "grd-001",
    "deck": "grounding",
    "text": "They’re my keys. I know where every one of them sleeps.",
    "tags": {
      "family": "thing",
      "role": "landlady",
      "half": "second",
      "topic": "keys"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-002",
    "deck": "grounding",
    "text": "I know what goes on under my roof. I’d be a poor landlady if I didn’t, and I’m not poor at anything.",
    "tags": {
      "family": "thing",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-003",
    "deck": "grounding",
    "text": "I don’t say a thing about my tenants unless I know it.",
    "tags": {
      "family": "thing",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-004",
    "deck": "grounding",
    "text": "I’d have heard {him}. I hear the mice.",
    "tags": {
      "family": "movements",
      "role": "landlady",
      "half": "second"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-005",
    "deck": "grounding",
    "text": "I hear every foot on those stairs, and I know most of them by the creak.",
    "tags": {
      "family": "movements",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-006",
    "deck": "grounding",
    "text": "I know {his} step. I’d know it in my sleep.",
    "tags": {
      "family": "movements",
      "role": "landlady",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-007",
    "deck": "grounding",
    "text": "I sit where I can see the door. Nobody goes up without I know it.",
    "tags": {
      "family": "counts",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-008",
    "deck": "grounding",
    "text": "I count them in and I count them out. It’s how I know who owes me.",
    "tags": {
      "family": "counts",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-009",
    "deck": "grounding",
    "text": "I don’t learn names off the backs of people’s coats.",
    "tags": {
      "family": "strangers",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-010",
    "deck": "grounding",
    "text": "If I don’t rent to somebody, they’re nobody to me.",
    "tags": {
      "family": "strangers",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-011",
    "deck": "grounding",
    "text": "I’d have remembered the name. I remember everybody’s, and what they owe.",
    "tags": {
      "family": "knowing",
      "role": "landlady"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "grd-012",
