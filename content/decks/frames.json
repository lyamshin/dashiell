      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-045",
    "deck": "frames",
    "text": "{business} \"That's between them and whoever else was there.\" \"{fact}, if you must have it.\"",
    "tags": {
      "register": "evasion",
