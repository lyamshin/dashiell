      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-050",
    "deck": "frames",
    "text": "{business} \"Plenty of people could tell you that better than me.\" {dashiell} \"{fact}.\"",
    "tags": {
