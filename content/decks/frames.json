  },
  {
    "id": "fra-055",
    "deck": "frames",
    "text": "{business} \"That's a question for somebody with less sense than me.\" {dashiell} \"{fact}.\"",
    "tags": {
      "register": "evasion",
      "temper": "plain",
      "familiar": "no"
    },
    "status": "generated"
  },
  {
    "id": "fra-056",
    "deck": "frames",
    "text": "{business} \"I don't make a habit of watching that closely.\" {dashiell} \"{fact}, {detective}. Satisfied?\"",
    "tags": {
      "register": "evasion",
      "temper": "plain",
      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-057",
    "deck": "frames",
    "text": "{business} \"There's things I notice and things I let go by.\" {dashiell} \"{fact}. You know I wouldn't lie to you outright.\"",
    "tags": {
      "register": "evasion",
      "temper": "plain",
      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-058",
    "deck": "frames",
    "text": "{business} \"That's not the kind of thing I keep straight.\" {dashiell} \"{fact}. There, now you've got it.\"",
