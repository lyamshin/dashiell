      "familiar": "no"
    },
    "status": "generated"
  },
  {
    "id": "fra-051",
    "deck": "frames",
    "text": "{business} \"I try not to keep track of things like that.\" {dashiell} \"{fact}. That's as much as I'll say.\"",
    "tags": {
      "register": "evasion",
      "temper": "plain",
      "familiar": "no"
    },
    "status": "generated"
  },
  {
    "id": "fra-052",
    "deck": "frames",
    "text": "{business} \"Some things are better left to the people involved.\" {dashiell} \"{fact}.\"",
    "tags": {
      "register": "evasion",
      "temper": "plain",
      "familiar": "no"
    },
    "status": "generated"
  },
  {
    "id": "fra-053",
    "deck": "frames",
    "text": "{business} \"You're fishing in the wrong pond with that one.\" {dashiell} \"{fact}, if it matters.\"",
    "tags": {
      "register": "evasion",
