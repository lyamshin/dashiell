      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-046",
    "deck": "frames",
    "text": "{business} \"Ask me something I actually know, {detective}.\" \"{fact}.\"",
    "tags": {
      "register": "evasion",
      "temper": "enigma",
      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-047",
    "deck": "frames",
    "text": "{business} \"There's a lot I don't ask about, on purpose.\" \"{fact}. For you, and nobody else.\"",
    "tags": {
