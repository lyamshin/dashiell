      "register": "evasion",
      "temper": "plain",
      "familiar": "yes"
    },
    "status": "generated"
  },
  {
    "id": "fra-059",
    "deck": "frames",
    "text": "{business} \"That's a family matter, and none of mine to spread.\" {dashiell} \"{fact}, {detective}.\"",
