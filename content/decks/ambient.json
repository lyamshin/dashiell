      "hourBand": "2-4",
      "caseState": "warm",
      "circumstance": "just-paid"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-103",
    "deck": "ambient",
    "text": "Getting paid up front meant I owed somebody something now, which was its own kind of weight.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "hot",
      "circumstance": "just-paid"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-104",
