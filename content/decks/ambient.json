      "hourBand": "4-6",
      "caseState": "cold",
      "circumstance": "bruised"
    },
    "motifs": [
      "cold"
    ],
    "weather": "cold",
    "status": "generated"
  },
  {
    "id": "amb-058",
    "deck": "ambient",
    "text": "I'd stopped noticing the jaw until I tried to talk too fast.",
