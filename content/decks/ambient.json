      "hourBand": "4-6",
      "caseState": "warm",
      "circumstance": "just-paid"
    },
    "motifs": [
      "money"
    ],
    "status": "generated"
  },
  {
    "id": "amb-107",
    "deck": "ambient",
    "text": "The money made the case feel real in a way it hadn't before the client signed.",
