      "hourBand": "2-4",
      "caseState": "any",
      "circumstance": "any"
    },
    "motifs": [
      "dawn"
    ],
    "status": "placeholder"
  },
  {
    "id": "amb-p010",
    "deck": "ambient",
    "text": "The office would be cold and the telephone would have nothing on it.",
