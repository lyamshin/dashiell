      "hourBand": "midnight-2",
      "caseState": "hot",
      "circumstance": "bruised"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-052",
    "deck": "ambient",
    "text": "Every fast move cost me something in the ribs I couldn't spare the time to feel.",
