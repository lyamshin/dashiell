      "hourBand": "2-4",
      "caseState": "hot",
      "circumstance": "bruised"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-056",
    "deck": "ambient",
    "text": "The bruise ached worse standing still than it did walking, and I couldn't account for that.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "tight",
      "circumstance": "bruised"
    },
    "motifs": [
      "quiet"
    ],
    "status": "generated"
  },
  {
    "id": "amb-057",
    "deck": "ambient",
    "text": "The cold made the bruised side ache worse than it had all night.",
