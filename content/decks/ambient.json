      "hourBand": "midnight-2",
      "caseState": "warm",
      "circumstance": "just-paid"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-099",
    "deck": "ambient",
    "text": "I hadn't spent a dime of it yet, and already felt better for having it.",
