      "caseState": "cold",
      "circumstance": "just-paid"
    },
    "motifs": [
      "money"
    ],
    "status": "generated"
  },
  {
    "id": "amb-098",
    "deck": "ambient",
    "text": "Getting paid up front changes how a man walks, if only for a night.",
