      "hourBand": "midnight-2",
      "caseState": "cold",
      "circumstance": "bruised"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-050",
    "deck": "ambient",
    "text": "The bruise on my jaw had gone from purple to something worse.",
