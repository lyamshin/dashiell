      "hourBand": "any",
      "caseState": "any",
      "circumstance": "flush"
    },
    "motifs": [
      "coat",
      "money"
    ],
    "status": "placeholder"
  },
  {
    "id": "amb-p009",
    "deck": "ambient",
    "text": "Four in the morning is when a man reads his own handwriting and doubts it.",
