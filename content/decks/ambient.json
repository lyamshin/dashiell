      "hourBand": "2-4",
      "caseState": "warm",
      "circumstance": "bruised"
    },
    "motifs": [
      "coat",
      "hands"
    ],
    "status": "generated"
  },
  {
    "id": "amb-055",
    "deck": "ambient",
    "text": "I ignored the ribs as best I could, which wasn't very well.",
