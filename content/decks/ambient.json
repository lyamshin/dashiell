      "hourBand": "midnight-2",
      "caseState": "warm",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "drink",
      "mouth"
    ],
    "status": "generated"
  },
  {
    "id": "amb-067",
    "deck": "ambient",
    "text": "At least this one wasn't about who slept where and when.",
    "tags": {
      "hourBand": "midnight-2",
      "caseState": "hot",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-068",
    "deck": "ambient",
    "text": "The divorce case had left me short on patience for people who lied about small things.",
    "tags": {
      "hourBand": "midnight-2",
      "caseState": "tight",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-069",
    "deck": "ambient",
    "text": "I thought about the husband from the last job, and how neither one of them had told the truth once.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "cold",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "work"
    ],
    "status": "generated"
  },
  {
    "id": "amb-070",
    "deck": "ambient",
    "text": "Compared to the last client, this one at least had the decency to be dead instead of just unhappy.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "warm",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-071",
    "deck": "ambient",
    "text": "The last case had soured me on marriage generally, which wasn't fair to anybody involved here.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "hot",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-072",
    "deck": "ambient",
    "text": "I was still owed for the divorce job, and probably always would be.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "tight",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "work"
    ],
    "status": "generated"
  },
  {
    "id": "amb-073",
    "deck": "ambient",
    "text": "The last client's wife had cried in my office for an hour over nothing worth crying about.",
    "tags": {
      "hourBand": "4-6",
      "caseState": "cold",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "office"
    ],
    "status": "generated"
  },
  {
    "id": "amb-074",
    "deck": "ambient",
    "text": "Two weeks of hotel-room photographs will do that to a man's opinion of people.",
    "tags": {
      "hourBand": "4-6",
      "caseState": "warm",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "photograph",
      "room"
    ],
    "status": "generated"
  },
  {
    "id": "amb-075",
    "deck": "ambient",
    "text": "At least nobody in this case was paying me to catch them lying to each other.",
    "tags": {
      "hourBand": "4-6",
      "caseState": "hot",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-076",
    "deck": "ambient",
    "text": "I'd taken the divorce work strictly for the fee, and it still hadn't felt like enough.",
    "tags": {
      "hourBand": "4-6",
      "caseState": "tight",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "money",
      "work"
    ],
    "status": "generated"
  },
  {
    "id": "amb-077",
    "deck": "ambient",
    "text": "The husband from the last case still owed me for the second week.",
    "tags": {
      "hourBand": "6-8",
      "caseState": "cold",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-078",
    "deck": "ambient",
    "text": "I hadn't slept right since that job either, if I was honest about it.",
    "tags": {
      "hourBand": "6-8",
      "caseState": "warm",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [
      "work"
    ],
    "status": "generated"
  },
  {
    "id": "amb-079",
    "deck": "ambient",
    "text": "This case at least had a body in it instead of just a marriage.",
    "tags": {
      "hourBand": "6-8",
      "caseState": "hot",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-080",
    "deck": "ambient",
    "text": "I was tired of other people's secrets before I even started on this one's.",
    "tags": {
      "hourBand": "6-8",
      "caseState": "tight",
      "circumstance": "off-a-divorce-case"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-081",
    "deck": "ambient",
    "text": "I hadn't slept right in three nights, and the fourth wasn't shaping up any better.",
    "tags": {
      "hourBand": "midnight-2",
      "caseState": "cold",
      "circumstance": "sleepless"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-082",
    "deck": "ambient",
    "text": "My eyes had that grainy feel that comes after too many nights without enough sleep.",
    "tags": {
      "hourBand": "midnight-2",
      "caseState": "warm",
      "circumstance": "sleepless"
    },
    "motifs": [
      "eyes",
      "sleep"
    ],
    "status": "generated"
  },
  {
    "id": "amb-083",
    "deck": "ambient",
    "text": "I was running on nerves and black coffee, and the coffee had run out.",
