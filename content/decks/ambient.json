      "caseState": "tight",
      "circumstance": "just-paid"
    },
    "motifs": [
      "money"
    ],
    "status": "generated"
  },
  {
    "id": "amb-105",
    "deck": "ambient",
    "text": "I'd pay off the landlady with this, first thing, before I let myself spend it on anything else.",
