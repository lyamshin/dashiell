      "hourBand": "midnight-2",
      "caseState": "tight",
      "circumstance": "bruised"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-053",
    "deck": "ambient",
    "text": "I probed the bruise once, out of habit, and regretted it once, out of habit too.",
    "tags": {
      "hourBand": "2-4",
      "caseState": "cold",
      "circumstance": "bruised"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-054",
    "deck": "ambient",
    "text": "The knuckle I'd split hadn't closed up right, and kept catching on my coat pocket.",
