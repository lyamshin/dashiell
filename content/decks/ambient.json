      "caseState": "cold",
      "circumstance": "just-paid"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-106",
    "deck": "ambient",
    "text": "It was a good fee for a bad hour, and I made a point of not weighing the two against each other.",
