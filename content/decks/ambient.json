      "hourBand": "6-8",
      "caseState": "tight",
      "circumstance": "sleepless"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-097",
    "deck": "ambient",
    "text": "The retainer was folded in my breast pocket, and I checked for it twice without meaning to.",
