      "hourBand": "6-8",
      "caseState": "cold",
      "circumstance": "sleepless"
    },
    "motifs": [
      "dawn",
      "sleep"
    ],
    "status": "generated"
  },
  {
    "id": "amb-094",
    "deck": "ambient",
    "text": "I'd earned a bed, and one was hours off yet, if it came at all.",
    "tags": {
      "hourBand": "6-8",
      "caseState": "warm",
      "circumstance": "sleepless"
    },
    "motifs": [
      "sleep"
    ],
    "status": "generated"
  },
  {
    "id": "amb-095",
    "deck": "ambient",
    "text": "The tiredness had a taste to it now, flat and a little sour.",
