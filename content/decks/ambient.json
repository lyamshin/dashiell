      "hourBand": "any",
      "caseState": "any",
      "circumstance": "hungover"
    },
    "motifs": [
      "drink",
      "eyes"
    ],
    "status": "placeholder"
  },
  {
    "id": "amb-p008",
    "deck": "ambient",
