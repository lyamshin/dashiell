      "hourBand": "6-8",
      "caseState": "hot",
      "circumstance": "sleepless"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "amb-096",
    "deck": "ambient",
    "text": "I was past tired and into something else, a kind of clear I didn't trust.",
