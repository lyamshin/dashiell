      "hourBand": "midnight-2",
      "caseState": "warm",
      "circumstance": "bruised"
    },
    "motifs": [
      "face"
    ],
    "status": "generated"
  },
  {
    "id": "amb-051",
    "deck": "ambient",
    "text": "I favored the side that still hurt without thinking about it.",
