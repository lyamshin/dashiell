[
  {
    "id": "tai-001",
    "deck": "tail",
    "text": "{He} takes the stairs like each one owes {him} money.",
    "joke": true,
    "tags": {
      "family": "movements",
      "temper": "yap",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "tai-002",
    "deck": "tail",
    "text": "You don’t miss {him}. Nobody does. People have tried.",
    "joke": true,
    "tags": {
      "family": "movements",
      "temper": "yap",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "tai-003",
    "deck": "tail",
    "text": "{He} never went anywhere quietly in {his} life.",
    "tags": {
      "family": "movements",
      "temper": "yap",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "tai-004",
    "deck": "tail",
    "text": "{He} always looks like {he}’s late for something, and usually is.",
    "joke": true,
    "tags": {
      "family": "movements",
      "temper": "yap",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "tai-005",
    "deck": "tail",
    "text": "I don’t keep track of {him} beyond that. I’ve got my own troubles.",
    "tags": {
      "family": "movements",
      "temper": "plain",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
  {
    "id": "tai-006",
    "deck": "tail",
    "text": "That’s the whole of what I know about {him}, and it’s more than I wanted to.",
    "joke": true,
    "tags": {
      "family": "movements",
      "temper": "yap",
      "knows": "name"
    },
    "motifs": [],
    "status": "generated"
  },
