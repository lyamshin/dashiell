{
  // Dashiell is a static site. This tells wrangler to upload dist/ as assets
  // and skip framework auto-detection (which wants Vite 6+).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashiell",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
