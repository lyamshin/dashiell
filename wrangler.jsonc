{
  // Dashiell is a static site deployed as a Cloudflare Worker with static assets.
  // `npx wrangler deploy` uploads dist/ and serves it. No framework detection.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashiell",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom domains (dashiell.app, www) are attached in the dashboard, not here:
  // declaring them in a deploy that runs under the build token fails.
  "routes": []
}
