{
  "name": "dashiell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashiell — a noir deduction game in the shape of a bound book, on the small board.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "case": "tsx src/cli/case.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "read": "tsx src/cli/read.ts",
    "play": "tsx src/cli/play.ts",
    "trace": "tsx scripts/trace-line.ts",
    "deploy": "sh scripts/deploy.sh",
    "board-sweep": "tsx src/cli/board-sweep.ts",
    "model:sample": "tsx scripts/model-sample.ts",
    "model:bench": "tsx scripts/model-bench.ts",
    "model:corpus": "tsx scripts/model-corpus.ts"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
